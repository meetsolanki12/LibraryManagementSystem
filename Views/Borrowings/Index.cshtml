@model IEnumerable<LibraryManagementSystem.Models.Borrowing>

@{
    ViewData["Title"] = "Borrowing Records";
}

<div class="container mt-4">
    <h2 class="mb-3">Borrowing Records</h2>

    <p class="text-muted">
        Select the number of days the user is allowed to keep the book.
        The maximum return period is 25 days.
    </p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>User</th>
                    <th>Book</th>
                    <th>Issue Date</th>
                    <th>Return By</th>
                    <th>Status</th>
                    <th style="min-width: 230px;">Action</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var isOverdue =
                            item.Status == "Borrowed" &&
                            item.DueDate < DateTime.Now;

                        <tr>
                            <td>@item.User?.Name</td>

                            <td>@item.Book?.Title</td>

                            <td>
                                @if (item.Status == "Requested")
                                {
                                    <span>Not issued yet</span>
                                }
                                else
                                {
                                    @item.IssueDate.ToString("dd MMM yyyy")
                                }
                            </td>

                            <td>
                                @if (item.Status == "Requested")
                                {
                                    <span>Not set</span>
                                }
                                else
                                {
                                    @item.DueDate.ToString("dd MMM yyyy")
                                }
                            </td>

                            <td>
                                @if (item.Status == "Requested")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Requested
                                    </span>
                                }
                                else if (item.Status == "Borrowed" && isOverdue)
                                {
                                    <span class="badge bg-danger">
                                        Overdue
                                    </span>
                                }
                                else if (item.Status == "Borrowed")
                                {
                                    <span class="badge bg-primary">
                                        Borrowed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        Returned
                                    </span>
                                }
                            </td>

                            <td>
                                @if (item.Status == "Requested")
                                {
                                    <form asp-action="Issue"
                                          asp-route-id="@item.BorrowingId"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <label class="form-label">
                                            Return period (days)
                                        </label>

                                        <div class="input-group">
                                            <input type="number"
                                                   name="returnDays"
                                                   class="form-control"
                                                   value="7"
                                                   min="1"
                                                   max="25"
                                                   step="1"
                                                   required />

                                            <button type="submit"
                                                    class="btn btn-success">
                                                Issue Book
                                            </button>
                                        </div>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">No action</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">
                            No borrowing records found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>