@model LibraryManagementSystem.Models.Book

@{
    ViewData["Title"] = "Book Details";
    var role = Context.Session.GetString("Role");
}

<style>
    body {
        background: #f4f7fb;
    }

    .page-header {
        background: linear-gradient(135deg, #1e3a8a, #2563eb);
        color: white;
        padding: 25px 30px;
        border-radius: 14px;
        margin-bottom: 25px;
    }

    .details-card {
        background: white;
        padding: 30px;
        border-radius: 14px;
        box-shadow: 0 4px 12px rgba(0,0,0,.07);
    }

    .detail-row {
        padding: 12px 0;
        border-bottom: 1px solid #e5e7eb;
    }

    .detail-label {
        font-weight: 600;
        color: #6b7280;
    }

    .action-buttons {
        margin-top: 25px;
    }
</style>

<div class="page-header">
    <h1>📖 Book Details</h1>
    <p class="mb-0">View book information</p>
</div>

<div class="details-card">

    <div class="detail-row">
        <div class="detail-label">Title</div>
        <div>@Model.Title</div>
    </div>

    <div class="detail-row">
        <div class="detail-label">Author</div>
        <div>@Model.Author</div>
    </div>

    <div class="detail-row">
        <div class="detail-label">ISBN</div>
        <div>@Model.ISBN</div>
    </div>

    <div class="detail-row">
        <div class="detail-label">Category</div>
        <div>@Model.Category?.CategoryName</div>
    </div>

    <div class="detail-row">
        <div class="detail-label">Total Quantity</div>
        <div>@Model.Quantity</div>
    </div>

    <div class="detail-row">
        <div class="detail-label">Available Quantity</div>
        <div>@Model.AvailableQuantity</div>
    </div>

    <div class="action-buttons">

        @if (role == "User")
        {
            @if (Model.AvailableQuantity > 0)
            {
                <a asp-controller="Books"
                   asp-action="Borrow"
                   asp-route-bookid="@Model.BookId"
                   class="btn btn-success">
                    Borrow
                </a>
            }
            else
            {
                <span class="btn btn-secondary disabled">
                    Not Available
                </span>
            }

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="btn btn-secondary">
                Close
            </a>
        }

        @if (role == "Admin")
        {
            <a asp-controller="Books"
               asp-action="Edit"
               asp-route-bookid="@Model.BookId"
               class="btn btn-primary">
                Edit
            </a>

            <a asp-controller="Books"
               asp-action="Delete"
               asp-route-bookid="@Model.BookId"
               class="btn btn-danger">
                Delete
            </a>

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="btn btn-secondary">
                Close
            </a>
        }

    </div>

</div>